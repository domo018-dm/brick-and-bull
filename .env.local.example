# Copy this file to .env.local and fill in your values

# Supabase — find these in your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Service role key for admin writes (Settings > API > service_role — keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin panel — password you type at /admin/login
ADMIN_PASSWORD=choose-a-strong-password

# Cloudinary — for photo uploads (optional; you can paste URLs manually instead)
# Find these at cloudinary.com > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Anthropic — for "Enhance with AI" on the admin description field
# Get your key at console.anthropic.com > API Keys
ANTHROPIC_API_KEY=your-key-here
